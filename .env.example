# Copia este archivo como .env y cambia los valores. El archivo .env NO se sube a GitHub.

# Base de datos (contenedor MySQL)
MYSQL_ROOT_PASSWORD=cambia-esta-clave-root
DB_NAME=auraarriendos
DB_USER=aura
DB_PASSWORD=cambia-esta-clave

# Secreto para firmar los JWT (mínimo 32 caracteres, distinto en cada ambiente)
JWT_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio-2026

# Puertos publicados en tu computador
BACKEND_PORT=8080
FRONTEND_PORT=3000

# Ruta a la carpeta del frontend (repositorio proyectoauraarriendos), relativa a este archivo
FRONTEND_PATH=../proyectoauraarriendos
